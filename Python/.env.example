# .env.example — template for the values docker-compose interpolates.
#
# Copy to .env and edit for your environment before running `docker compose`.
# .env is gitignored because these values are machine- and corpus-specific.
#
# Note the two kinds below: CORPUS_HOST_PATH is a path on the Windows host,
# SERIES_DEFAULT_DB is a path inside the corpus as the container sees it.
# Windows host paths use forward slashes for Docker Desktop compatibility.
# Do not quote the values — docker-compose reads them literally.

# Full path to the corpus root on the host.
#
# ⚠ This must be the root of THIS repository checkout — the directory containing
# Python/, Core_Rules/ and your World_Building/. The corpus root and the repo root
# are the same directory by design: the engine resolves its own tooling through the
# mount (index-tools runs /corpus/Python/build_indexes.py), so pointing this at a
# separate content folder leaves that path unresolvable and index rebuilds fail with
# a confusing "can't open file" error while the containers otherwise look healthy.
#
# Right: the clone itself, with your content in a World_Building/ subdirectory.
# Wrong: a content directory somewhere else, with the clone living apart from it.
CORPUS_HOST_PATH=D:/claude/filesystem

# Corpus-relative path to the default series-search database (NOT a host path —
# this one is relative to the corpus root, inside the container). Used when a
# series-search tool call omits its `db` argument. Leave blank to require an
# explicit db on every call; series-search then errors with a message naming
# this variable rather than failing inside sqlite.
SERIES_DEFAULT_DB=Other_References/Some_Series/series.db
